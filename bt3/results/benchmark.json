  "queries": {
    "where": {
      "before": "SELECT COUNT(*) AS trip_count, SUM(fare_amount) AS total_fare\nFROM bt3.trips\nWHERE pickup_at::date = DATE '2024-01-15'",
      "after": "SELECT COUNT(*) AS trip_count, SUM(fare_amount) AS total_fare\nFROM bt3.trips\nWHERE pickup_at >= TIMESTAMP '2024-01-15 00:00:00'\n  AND pickup_at < TIMESTAMP '2024-01-16 00:00:00'"
    },
    "group_by": {
      "before": "SELECT pickup_location_id, dropoff_location_id,\n       COUNT(*) AS trip_count, SUM(fare_amount) AS total_fare\nFROM bt3.trips\nGROUP BY pickup_location_id, dropoff_location_id,\n         (pickup_location_id::text || '/' || dropoff_location_id::text)",
      "after": "SELECT pickup_location_id, dropoff_location_id,\n       COUNT(*) AS trip_count, SUM(fare_amount) AS total_fare\nFROM bt3.trips\nGROUP BY pickup_location_id, dropoff_location_id"
    },
    "having": {
      "before": "SELECT pickup_location_id, dropoff_location_id,\n       COUNT(*) AS trip_count, SUM(fare_amount) AS total_fare\nFROM bt3.trips\nGROUP BY pickup_location_id, dropoff_location_id\nHAVING COUNT(DISTINCT provider_id) > 1",
      "after": "SELECT pickup_location_id, dropoff_location_id,\n       COUNT(*) AS trip_count, SUM(fare_amount) AS total_fare\nFROM bt3.trips\nGROUP BY pickup_location_id, dropoff_location_id\nHAVING MIN(provider_id) <> MAX(provider_id)"
    }
  },
